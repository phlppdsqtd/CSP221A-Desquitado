# Chapter 5: Vectors & Similarity

import numpy as np

student_a = np.array([90, 85, 78])   # e.g., scores on 3 tests
student_b = np.array([88, 80, 75])

# 5.2 Basic Vector Operations
print(student_a + student_b)   # [178 165 153] — elementwise addition
print(student_a - student_b)   # [2 5 3]
print(student_a * 2)           # [180 170 156] — scalar multiplication

# 5.3 Dot Product
dot = np.dot(student_a, student_b)
print(dot)   # 90*88 + 85*80 + 78*75 = 20570

# 5.4 Magnitude (Norm)
magnitude = np.linalg.norm(student_a)
print(magnitude)   # sqrt(90^2 + 85^2 + 78^2) ≈ 146.32

# 5.5 Euclidean Distance
distance = np.linalg.norm(student_a - student_b)
print(distance)   # ≈ 6.16

# 5.6 Cosine Similarity
def cosine_similarity(a, b):
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))
print(cosine_similarity(student_a, student_b))   # ≈ 0.9998 — nearly identical direction

# 5.7 The Practical Tool: scikit-learn
from sklearn.metrics.pairwise import cosine_similarity
vectors = np.array([student_a, student_b])
print(cosine_similarity(vectors))
# [[1.     0.9998...]
#  [0.9998... 1.    ]] — a full similarity matrix, every vector compared to every other

# 5.8 Semantic Search & RAG: Where This Math Actually Lives
doc_vectors = np.array([
    [0.02, -0.31, 0.88],   # "The cat sat on the mat"
    [0.03, -0.29, 0.85],   # "A feline rested on the rug"
    [-0.71, 0.44, -0.02],  # "Stock prices rose sharply"
])
doc_texts = ["The cat sat on the mat", "A feline rested on the rug", "Stock prices rose sharply"]
query_vector = np.array([0.01, -0.30, 0.86])   # embedding of "Where did the cat rest?"
similarities = cosine_similarity(doc_vectors, query_vector.reshape(1, -1)).flatten()
best_match = doc_texts[np.argmax(similarities)]
print(best_match)   # "The cat sat on the mat" — highest cosine similarity to the query

