print(data.sum())          # 21 — sum of everything
print(data.sum(axis=0))    # [5 7 9] — sum DOWN each column
print(data.sum(axis=1))    # [6 15] — sum ACROSS each row
print(data.mean())         # 3.5

print(np.where(data > 3, "high", "low"))
# [['low' 'low' 'low']
