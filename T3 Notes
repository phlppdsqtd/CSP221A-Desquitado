# Standard Python lists print with commas separating the items.
# However, NumPy specifically removes the commas and aligns the numbers with spaces when you use print()

a = np.array([1, 2])
b = np.array([3, 4])
print(a)
print(b)
print(np.concatenate([a, b]))   # [1 2 3 4]
print(np.stack([a, b]))         # [[1 2] [3 4]] — stacks as new rows

