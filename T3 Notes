# ----- CORRECT WAY -----

# STEP 1: Convert score column from string to numeric (float)
df["score"] = pd.to_numeric(df["score"], errors="coerce")

# STEP 2: Fill missing values with 0 so calculations don't fail on NaN
df["score_clean"] = df["score"].fillna(0)

# STEP 3: Now apply() works because it compares numbers (e.g., 90.0 >= 60)
df["passed"] = df["score_clean"].apply(lambda x: "Yes" if x >= 60 else "No")

# STEP 4: Now map() works because score values (90.0) match numeric dictionary keys
grade_labels = {90: "A", 85: "B", 78: "C"}
df["letter"] = df["score_clean"].map(grade_labels)

# STEP 5: Row-wise apply works naturally
df["summary"] = df.apply(lambda row: f"{row['name'].strip()}: {row['score']}", axis=1)

print(df[["name", "score", "passed", "letter", "summary"]])

