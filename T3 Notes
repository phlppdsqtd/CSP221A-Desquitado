import numpy as np, time

n = 2_000_000
arr = np.arange(n)

start = time.time()
result = [x * 2 for x in arr]   # pure Python loop (via comprehension)
loop_time = time.time() - start

start = time.time()
result = arr * 2                # vectorized NumPy
vector_time = time.time() - start

print(f"Loop: {loop_time:.4f}s, Vectorized: {vector_time:.4f}s")
# Loop: ~0.3s, Vectorized: ~0.005s — vectorized is dramatically faster

