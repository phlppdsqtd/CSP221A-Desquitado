prices = np.array([10, 20, 30])
print(prices * 1.1)   # [11. 22. 33.] — a scalar "broadcasts" across every element

matrix = np.array([[1, 2, 3], [4, 5, 6]])
row = np.array([10, 20, 30])
print(matrix + row)
# [[11 22 33]
#  [14 25 36]] — row broadcasts across every row of the matrix
# must be same dimension as number of columns (3,) or not exceed number of rows (2,3 max) >> (3,3) will be ValueErro

matrix1 = np.array([[1, 2, 3], [4, 5, 6]])
matrix2 = np.array([[10, 20, 30], [40, 50, 60]])
print(matrix1 + matrix2)
# [[11 22 33]
#  [44 55 66]]
# adds same row to same row, same column to same column

